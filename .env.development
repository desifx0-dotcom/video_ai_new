# Flask Configuration
FLASK_APP=app:app
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=${SECRET_KEY}
DEBUG=true

# Database Configuration
DATABASE_PROVIDER=firebase

# Firebase Configuration (development)
FIREBASE_PROJECT_ID=video-ai-studio-dev
FIREBASE_CREDENTIALS_PATH=./config/firebase-dev.json

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AI Providers (use test keys or leave empty for mock)
OPENAI_API_KEY=sk-test-key
GOOGLE_API_KEY=test-key
STABILITY_API_KEY=sk-test-key

# Email Configuration
EMAIL_PROVIDER=console  # Print emails to console

# Payment Configuration (test mode)
STRIPE_SECRET_KEY=sk_test_51YourTestKey
STRIPE_WEBHOOK_SECRET=whsec_test_YourTestWebhookSecret
STRIPE_PUBLISHABLE_KEY=pk_test_YourTestPublishableKey

# Feature Flags
ENABLE_SILENT_DETECTION=true
ENABLE_TRANSLATION=true
ENABLE_VIDEO_STYLES=true
ENABLE_AI_THUMBNAILS=true

# Rate Limiting (higher for development)
RATE_LIMIT_FREE=100
RATE_LIMIT_STARTER=500
RATE_LIMIT_PRO=2000
RATE_LIMIT_PLUS=10000

# Video Processing
MAX_UPLOAD_SIZE=536870912  # 500MB for development
MAX_PROCESSING_TIME=300  # 5 minutes for development
DEFAULT_QUALITY=720p

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# Application URLs
APP_URL=http://localhost:5000
API_URL=http://localhost:5000/api/v1

# Security (relaxed for development)
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=simple  # Simple format for development
LOG_FILE=./logs/development.log

# Cleanup
CLEANUP_INTERVAL_HOURS=1  # More frequent cleanup in dev
MAX_TEMP_FILE_AGE_HOURS=1
MAX_COMPLETED_VIDEO_AGE_DAYS=1

# Development-specific
FLASK_DEBUG=1
PYTHONUNBUFFERED=1
RELOAD=1

# MailHog for email testing
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Test database
TEST_DATABASE_URL=postgresql://test:test@localhost:5433/video_ai_test
TEST_REDIS_URL=redis://localhost:6379/1
# Flask Configuration
FLASK_APP=app:app
FLASK_ENV=testing
SECRET_KEY=test-secret-key
JWT_SECRET_KEY=${SECRET_KEY}
TESTING=true

# Database Configuration
DATABASE_PROVIDER=memory  # Use in-memory database for tests

# Firebase Configuration (mock)
FIREBASE_PROJECT_ID=test-project
FIREBASE_CREDENTIALS_PATH=./config/firebase-test.json

# Redis Configuration
REDIS_URL=redis://localhost:6379/2  # Use different database

# AI Providers (mock mode)
OPENAI_API_KEY=test-key
GOOGLE_API_KEY=test-key
STABILITY_API_KEY=test-key

# Email Configuration
EMAIL_PROVIDER=mock  # Mock email for tests

# Payment Configuration (test mode with mocks)
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_test_mock
STRIPE_PUBLISHABLE_KEY=pk_test_mock

# Feature Flags (disable expensive features for tests)
ENABLE_SILENT_DETECTION=false
ENABLE_TRANSLATION=false
ENABLE_VIDEO_STYLES=false
ENABLE_AI_THUMBNAILS=false

# Rate Limiting (disabled for tests)
RATE_LIMIT_FREE=10000
RATE_LIMIT_STARTER=10000
RATE_LIMIT_PRO=10000
RATE_LIMIT_PLUS=10000

# Video Processing
MAX_UPLOAD_SIZE=10485760  # 10MB for tests
MAX_PROCESSING_TIME=30  # 30 seconds for tests
DEFAULT_QUALITY=480p

# CORS Configuration
CORS_ORIGINS=http://test.local

# Application URLs
APP_URL=http://test.local:5000
API_URL=http://test.local:5000/api/v1

# Security
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false

# Logging
LOG_LEVEL=WARNING  # Reduce log noise during tests
LOG_FORMAT=simple
LOG_FILE=./logs/test.log

# Cleanup (fast for tests)
CLEANUP_INTERVAL_HOURS=0.1  # 6 minutes
MAX_TEMP_FILE_AGE_HOURS=0.1
MAX_COMPLETED_VIDEO_AGE_DAYS=0.1

# Testing-specific
PYTEST_ADDOPTS=-v
COVERAGE=1
TEST_DATABASE=memory
TEST_REDIS_DB=2

# Mock server URLs
MOCK_OPENAI_URL=http://localhost:8081
MOCK_GOOGLE_URL=http://localhost:8082
MOCK_STRIPE_URL=http://localhost:8083